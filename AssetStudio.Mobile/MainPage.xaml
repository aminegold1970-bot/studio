<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AssetStudioMobile.MainPage" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0" ColumnDefinitions="*">
        <Grid Grid.Row="0" HeightRequest="44" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}">
            <ScrollView x:Name="MenuScroll" HeightRequest="44" Orientation="Horizontal" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                        SizeChanged="OnMenuScrollSizeChanged" Scrolled="OnMenuScrollScrolled">
                <HorizontalStackLayout Padding="4,0" Spacing="0" SizeChanged="OnMenuScrollSizeChanged">
                    <Button Text="File" Clicked="OnFileMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Options" Clicked="OnOptionsMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Model" Clicked="OnModelMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Export" Clicked="OnExportMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button x:Name="FilterTypeMenuButton" Text="Filter Type" Clicked="OnFilterMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Debug" Clicked="OnDebugMenuClicked" Style="{StaticResource MenuButton}"/>
                </HorizontalStackLayout>
            </ScrollView>
            <Button x:Name="MenuOverflowButton" Text="▸" Clicked="OnMenuOverflowClicked"
                    IsVisible="False" HorizontalOptions="End" VerticalOptions="Center"
                    Padding="0" WidthRequest="24" HeightRequest="44" MinimumWidthRequest="24"
                    MinimumHeightRequest="0" FontSize="13" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}"
                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}" BorderWidth="0"
                    AutomationProperties.Name="More menu items"
                    SemanticProperties.Hint="Scroll the menu bar to reveal more commands"/>
        </Grid>

        <Grid x:Name="WorkspaceViewTabs" Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="2,0" ColumnSpacing="1"
              BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}" IsVisible="False">
            <Button x:Name="SceneWorkspaceTab" Grid.Column="0" Text="Hierarchy" CommandParameter="Scene Hierarchy"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="AssetsWorkspaceTab" Grid.Column="1" Text="Assets" CommandParameter="Asset List"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="ClassesWorkspaceTab" Grid.Column="2" Text="Classes" CommandParameter="Asset Classes"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="PreviewWorkspaceTab" Grid.Column="3" Text="Preview" CommandParameter="Preview"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="DumpWorkspaceTab" Grid.Column="4" Text="Dump" CommandParameter="Dump"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="*,28,0*" RowDefinitions="*" ColumnSpacing="0" BackgroundColor="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}" SizeChanged="OnWorkspaceSizeChanged">
            <Grid x:Name="BrowserPane" Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">                        <Grid x:Name="BrowserTabsGrid" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Padding="2,0" ColumnSpacing="1" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}">
            <Button x:Name="HierarchyTab" Grid.Column="0" Text="Scene Hierarchy" CommandParameter="Scene Hierarchy" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="AssetListTab" Grid.Column="1" Text="Asset List" CommandParameter="Asset List" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="ClassesTab" Grid.Column="2" Text="Asset Classes" CommandParameter="Asset Classes" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
        </Grid>

        <Grid x:Name="BrowserToolbarGrid" Grid.Row="1" RowDefinitions="21,Auto,Auto,Auto" Padding="2,0" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}">
            <Border x:Name="AssetSearchFrame" Stroke="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" HeightRequest="21">
                <Entry x:Name="AssetSearch" Placeholder=" Filter " PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#9A9A9A}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" TextChanged="OnAssetSearchTextChanged"/>
            </Border>
            <Border x:Name="ClassSearchFrame" Grid.Row="0" IsVisible="False" Stroke="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" HeightRequest="21">
                <Entry x:Name="ClassSearch" Placeholder="Search" PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#9A9A9A}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" TextChanged="OnClassSearchTextChanged"/>
            </Border>
            <Grid x:Name="HierarchySearchPanel" Grid.Row="0" IsVisible="False">
                <Border x:Name="HierarchySearchFrame" Stroke="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" HeightRequest="21">
                    <Entry x:Name="HierarchySearch" TextColor="{AppThemeBinding Light=#777777, Dark=#9A9A9A}" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" ReturnType="Search" Completed="OnHierarchySearchButtonPressed" TextChanged="OnHierarchySearchTextChanged" Focused="OnHierarchySearchFocused" Unfocused="OnHierarchySearchUnfocused"/>
                </Border>
            </Grid>
            <Grid x:Name="AssetColumnHeaders" Grid.Row="3" ColumnDefinitions="2*,1.25*,1.1*,1.1*,.7*,34" Padding="3,3" ColumnSpacing="2">
                <Button Text="Name" Clicked="OnSortName" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="1" Text="Container" Clicked="OnSortContainer" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="2" Text="Type" Clicked="OnSortType" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="3" Text="PathID" Clicked="OnSortPathId" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="4" Text="Size" Clicked="OnSortSize" Style="{StaticResource HeaderButton}"/>
            </Grid>
            <Grid x:Name="ClassColumnHeaders" Grid.Row="3" IsVisible="False" ColumnDefinitions="Auto,*" Padding="3,3" ColumnSpacing="2">
                <Button Text="ID" Clicked="OnClassSortIdClicked" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="1" Text="Name" Clicked="OnClassSortNameClicked" Style="{StaticResource HeaderButton}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                <CollectionView x:Name="AssetCollection" SelectionMode="Multiple" SelectionChanged="OnAssetSelectionChanged" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                    <CollectionView.EmptyView>
                        <Label x:Name="AssetEmptyLabel" Text="No assets loaded. Use File → Load file to load Unity assets." TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*" Padding="3,1" RowDefinitions="Auto,1" MinimumHeightRequest="26">
                                <Grid Grid.RowSpan="2" ColumnDefinitions="2*,1.25*,1.1*,1.1*,.7*,34"
                                      ColumnSpacing="5" IsVisible="{Binding IsDesktopLayout}">
                                    <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="12" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding Container}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="2" Text="{Binding Type}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="3" Text="{Binding PathId}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="11"/>
                                    <Label Grid.Column="4" Text="{Binding Size}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="11"/>
                                    <Button Grid.Column="5" Text="" Clicked="OnAssetContextClicked" AutomationProperties.Name="Asset actions" SemanticProperties.Hint="Open asset actions" CommandParameter="{Binding .}" Padding="0" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="0" MinimumHeightRequest="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="16"/>
                                </Grid>
                                <Grid Grid.Row="0" ColumnDefinitions="*,34" RowDefinitions="Auto,Auto" RowSpacing="2"
                                      IsVisible="{Binding IsCompactLayout}">
                                    <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Button Grid.Column="1" Grid.RowSpan="2" Text="" Clicked="OnAssetContextClicked" AutomationProperties.Name="Asset actions" SemanticProperties.Hint="Open asset actions" CommandParameter="{Binding .}" Padding="0" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="0" MinimumHeightRequest="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="16"/>
                                    <Label Grid.Row="1" Text="{Binding CompactDetails}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="9" LineBreakMode="TailTruncation"/>
                                </Grid>
                                <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#D6D6D6, Dark=#3A3A3A}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView x:Name="HierarchyCollection" IsVisible="False" SelectionMode="Single" SelectionChanged="OnHierarchySelectionChanged" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                    <CollectionView.EmptyView><Label Text="No scene hierarchy loaded" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,18,Auto,*" Padding="4,1" ColumnSpacing="2" MinimumHeightRequest="24">
                                <Label Text="{Binding TreePrefix}" TextColor="{AppThemeBinding Light=#888888, Dark=#9A9A9A}" FontSize="11" FontFamily="Courier New" VerticalTextAlignment="Center" LineBreakMode="NoWrap"/>
                                <Button Grid.Column="1" Text="{Binding ExpandGlyph}" Clicked="OnHierarchyExpandClicked" IsVisible="{Binding HasChildren}" Padding="0" WidthRequest="16" HeightRequest="16" MinimumWidthRequest="16" MinimumHeightRequest="16" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" BorderColor="{AppThemeBinding Light=#888888, Dark=#9A9A9A}" BorderWidth="1" CornerRadius="0" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="11"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsChecked, Mode=TwoWay}" CheckedChanged="OnHierarchyCheckChanged" WidthRequest="16" HeightRequest="16" MinimumWidthRequest="0" MinimumHeightRequest="0" Color="{AppThemeBinding Light=#2878C8, Dark=#4FA3F7}"/>
                                <Label Grid.Column="3" Text="{Binding DisplayName}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" VerticalTextAlignment="Center" FontSize="11" LineBreakMode="TailTruncation"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView x:Name="ClassesCollection" IsVisible="False" SelectionMode="Single" SelectionChanged="OnClassSelectionChanged" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Version}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontAttributes="Bold" FontSize="10"
                                   BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}" Padding="6,3"/>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.EmptyView><Label x:Name="ClassEmptyLabel" Text="No asset classes were loaded." TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" Padding="5,4" ColumnSpacing="8">
                                <Label Text="{Binding Id}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="10" VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="11" VerticalTextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            </Grid><Grid x:Name="WorkspaceDivider" Grid.Row="0" Grid.Column="1" WidthRequest="28" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                         AutomationProperties.Name="Resize asset and preview panes"
                         SemanticProperties.Hint="Drag to resize panes. Tap to show or hide the preview pane.">
                <Button x:Name="WorkspacePaneToggleButton" Text="&gt;" Clicked="OnWorkspaceDividerToggleClicked"
                        Padding="0" WidthRequest="28" HeightRequest="44" MinimumWidthRequest="28"
                        MinimumHeightRequest="44" FontSize="14" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}"
                        BackgroundColor="Transparent" BorderWidth="0"/>
            </Grid>            <Grid x:Name="PreviewPane" Grid.Row="0" Grid.Column="2" RowDefinitions="*" RowSpacing="0" BackgroundColor="{AppThemeBinding Light=#A7A5A6, Dark=#2A2A2A}"><Grid x:Name="PreviewTabsGrid" RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}" Grid.Row="0">
                <Grid ColumnDefinitions="Auto,Auto,*" Padding="2,1" ColumnSpacing="1" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}">
                    <Button x:Name="PreviewTab" Text="Preview" Clicked="OnPreviewTabClicked" Style="{StaticResource TabButton}"/>
                    <Button x:Name="DumpTab" Grid.Column="1" Text="Dump" Clicked="OnDumpTabClicked" Style="{StaticResource TabButton}"/>
                </Grid>
                <Grid x:Name="EmptyPreviewSurface" Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#A7A5A6, Dark=#2A2A2A}" IsVisible="True">
                    <Label x:Name="PreviewEmptyLabel" Text="Select an asset&#10;to preview" TextColor="{AppThemeBinding Light=#666466, Dark=#B8B8B8}" FontSize="26"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
                <ScrollView x:Name="PreviewScroll" Grid.Row="1" Padding="8" IsVisible="False">
                    <VerticalStackLayout Spacing="9">
                        <Label x:Name="PreviewTitle" Text="Preview" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="16" FontAttributes="Bold"/>
                        <Label x:Name="PreviewKind" Text="Select an asset" TextColor="{AppThemeBinding Light=#666666, Dark=#A8A8A8}" FontSize="11"/>
                        <Border x:Name="ImagePreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="6">
                            <VerticalStackLayout Spacing="6">
                                <Image x:Name="AssetImagePreview" Aspect="AspectFit" HeightRequest="230"/>
                                <HorizontalStackLayout x:Name="TextureActionsRow" Spacing="6" IsVisible="False">
                                    <Button x:Name="TextureChannelsButton" Text="Channels: BGRA" Clicked="OnTextureChannelsClicked"
                                            Style="{StaticResource TabButton}"/>
                                    <Button x:Name="OpenFullTexturePreviewButton" Text="Open full-screen" Clicked="OnFullTexturePreviewClicked"
                                            Style="{StaticResource TabButton}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="TextPreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="6">
                                <ScrollView Orientation="Both" HeightRequest="210">
                                    <Label x:Name="AssetTextPreview" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontFamily="monospace" FontSize="11" LineBreakMode="NoWrap"/>
                                </ScrollView>
                                <HorizontalStackLayout x:Name="ScriptAssemblyActionsRow" Spacing="6" IsVisible="False">
                                    <Button Text="Load script assemblies" Clicked="OnLoadScriptAssembliesClicked"
                                            Style="{StaticResource TabButton}"/>
                                    <Button Text="Clear script assemblies" Clicked="OnClearScriptAssembliesClicked"
                                            Style="{StaticResource TabButton}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="VideoPreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#111111, Dark=#000000}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="6">
                            <VerticalStackLayout Spacing="8">
                                <Image x:Name="VideoThumbnailImage" HeightRequest="180"
                                       Aspect="AspectFit" IsVisible="False"/>
                                <ContentView x:Name="VideoPlayerHost" HeightRequest="240" IsVisible="False"/>
                                <Button x:Name="LoadVideoPlaybackButton" Text="Load video for playback"
                                        Clicked="OnVideoPlayerClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                                <Label x:Name="VideoPlaybackStatus" Text="Select Load video to start playback."
                                       TextColor="{AppThemeBinding Light=#EEEEEE, Dark=#F2F2F2}" FontSize="11"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="FontPreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#2C2C2C}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="10">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Font specimen" TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" FontSize="11"/>
                                <Label x:Name="FontSpecimenTiny" Text="abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWYZ" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="16"/>
                                <Label x:Name="FontSpecimenSmall" Text="1234567890.:,;'\&quot;(!?)+-*/=" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="12"/>
                                <Label x:Name="FontSpecimenMedium" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="18"/>
                                <Label x:Name="FontSpecimenLarge" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="24"/>
                                <Label x:Name="FontSpecimenXLarge" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="36"/>
                                <Label x:Name="FontSpecimenHuge" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="48"/>
                                <Label x:Name="FontSpecimenSize60" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="60"/>
                                <Label x:Name="FontSpecimenSize72" Text="The quick brown fox jumps over the lazy dog. 1234567890" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" FontSize="72"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="AudioPreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#2C2C2C}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Audio clip" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontAttributes="Bold"/>
                                <Label x:Name="AudioPreviewInfo" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="12"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label x:Name="AudioPlaybackStatus" Text="Stopped" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="11" VerticalTextAlignment="Center"/>
                                    <Label x:Name="AudioFrequency" Grid.Column="1" Text="— Hz" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="11" VerticalTextAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="AudioSeekSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="OnAudioSeekChanged"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="AudioCurrentTime" Text="0:00.0" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="10"/>
                                    <Label x:Name="AudioDuration" Grid.Column="1" Text="0:00.0" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="10"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Button Text="Play" Clicked="OnAudioPlayClicked" Style="{StaticResource TabButton}"/>
                                    <Button x:Name="AudioPauseButton" Grid.Column="1" Text="Pause" Clicked="OnAudioPauseClicked" Style="{StaticResource TabButton}"/>
                                    <Button Grid.Column="2" Text="Stop" Clicked="OnAudioStopClicked" Style="{StaticResource TabButton}"/>
                                    <Button x:Name="AudioLoopButton" Grid.Column="3" Text="Loop" Clicked="OnAudioLoopClicked" Style="{StaticResource TabButton}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="Volume" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="11" VerticalTextAlignment="Center"/>
                                    <Slider x:Name="AudioVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" ValueChanged="OnAudioVolumeChanged"/>
                                </Grid>
                                <Label Text="PCM, Vorbis/Ogg and managed ADPCM/VAG convert to WAV; MP3 and AAC use native playback. Other codecs remain exportable as original data." TextColor="{AppThemeBinding Light=#666666, Dark=#A8A8A8}" FontSize="10"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="ModelPreviewFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="3D model preview" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontAttributes="Bold"/>
                                <Label x:Name="ModelPreviewInfo" Text="Select a Mesh asset to open its wireframe viewer." TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="12"/>
                                <GraphicsView x:Name="InlineMeshView" HeightRequest="180" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#A7A5A6, Dark=#2A2A2A}"
                                              AutomationProperties.Name="Inline mesh wireframe preview"
                                              SemanticProperties.Hint="Drag to rotate and pinch to zoom the mesh."/>
                                <Button x:Name="OpenMeshPreviewButton" Text="Open wireframe preview" Clicked="OnMeshPreviewClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                                <Button x:Name="OpenSceneObjectPreviewButton" Text="Preview selected scene object" Clicked="OnSceneObjectPreviewClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="MetadataFrame" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#3F3F3F}" StrokeThickness="1" Padding="0">
                            <VerticalStackLayout x:Name="MetadataHost" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,1.2*" Padding="4,4" ColumnSpacing="8">
                                            <Label Text="{Binding Key}" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="11"/>
                                            <Label Grid.Column="1" Text="{Binding Value}" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="11" HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label x:Name="PreviewDetails" Text="Select an asset to inspect it." TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="12"/>
                    </VerticalStackLayout>
                </ScrollView>
                <ScrollView x:Name="DumpScroll" Grid.Row="1" Padding="8" IsVisible="False">
                    <Label x:Name="DumpText" Text="Select an asset to view its dump." TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontFamily="monospace" FontSize="11"/>
                </ScrollView>
            </Grid>
        </Grid></Grid>        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,3" ColumnDefinitions="*,Auto,Auto" Padding="5,2,5,0" ColumnSpacing="6" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}">
            <Label x:Name="StatusLabel" Grid.Row="0" Text="Ready to go" TextColor="{AppThemeBinding Light=#444444, Dark=#D0D0D0}" FontSize="12" VerticalTextAlignment="Center"/>
            <Label x:Name="LoadInfoLabel" Grid.Row="1" Text="" TextColor="{AppThemeBinding Light=#666666, Dark=#A8A8A8}" FontSize="9" IsVisible="False" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
            <Button x:Name="CancelLoadButton" Grid.Row="0" Grid.Column="1" Text="Cancel load" IsVisible="False" Clicked="OnCancelLoadClicked" Padding="8,3" HeightRequest="26" MinimumHeightRequest="0" MinimumWidthRequest="0" FontSize="10" BackgroundColor="{AppThemeBinding Light=#7B3438, Dark=#A34A4E}" TextColor="White"/>
            <ActivityIndicator x:Name="BusyIndicator" Grid.Row="0" Grid.Column="2" IsRunning="False" IsVisible="False" HeightRequest="20"/>
            <ProgressBar x:Name="LoadProgressBar" Grid.Row="2" Grid.ColumnSpan="3" Progress="0" IsVisible="False" ProgressColor="{AppThemeBinding Light=#2878C8, Dark=#4FA3F7}" BackgroundColor="{AppThemeBinding Light=#D0D0D0, Dark=#3A3A3A}" HeightRequest="3"/>
        </Grid>
        <Grid x:Name="MenuOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200">
            <BoxView BackgroundColor="#01000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuOverlayBackgroundTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="MenuPopupFrame" HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="4,44,4,0" WidthRequest="480" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#888888, Dark=#9A9A9A}" StrokeThickness="1" Padding="0" ZIndex="201">
                <ScrollView x:Name="MenuOptionsScroll" VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="MenuOptionsHost" Spacing="0"/>
                </ScrollView>
            </Border>
        </Grid>
        <Grid x:Name="DropTargetOverlay" Grid.RowSpan="4" IsVisible="False" InputTransparent="True"
              BackgroundColor="#662878C8" ZIndex="100">
            <Border Stroke="{AppThemeBinding Light=#2878C8, Dark=#4FA3F7}" StrokeThickness="3" BackgroundColor="{AppThemeBinding Light=#F5FFFFFF, Dark=#CC1E1E1E}"
                    Padding="28,20" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Drop files or folders to load" TextColor="{AppThemeBinding Light=#202020, Dark=#F2F2F2}" FontSize="18"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Unity assets, bundles, folders, ZIP and RAR files" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B8B8}" FontSize="12"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="DropDetectionLabel" Text="Waiting for a drop" TextColor="{AppThemeBinding Light=#2878C8, Dark=#4FA3F7}" FontSize="11"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="13"/><Setter Property="TextColor" Value="{AppThemeBinding Light=#202020, Dark=#F2F2F2}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"/><Setter Property="BorderColor" Value="Transparent"/>
                <Setter Property="BorderWidth" Value="0"/><Setter Property="HeightRequest" Value="44"/>
                <Setter Property="MinimumHeightRequest" Value="44"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="PopupMenuItem" TargetType="Border">
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>
                <Setter Property="Stroke" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="HeightRequest" Value="24"/>
                <Setter Property="MinimumHeightRequest" Value="24"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="Padding" Value="2,1"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="10"/><Setter Property="TextColor" Value="{AppThemeBinding Light=#444444, Dark=#D0D0D0}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="BorderColor" Value="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}"/>
                <Setter Property="BorderWidth" Value="1"/><Setter Property="HeightRequest" Value="22"/>
                <Setter Property="MinimumHeightRequest" Value="0"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="Padding" Value="5,0"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="10"/><Setter Property="TextColor" Value="{AppThemeBinding Light=#202020, Dark=#F2F2F2}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E2E2, Dark=#3A3A3A}"/><Setter Property="BorderColor" Value="{AppThemeBinding Light=#B7B7B7, Dark=#3A3A3A}"/>
                <Setter Property="BorderWidth" Value="1"/><Setter Property="HeightRequest" Value="22"/>
                <Setter Property="MinimumHeightRequest" Value="0"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>
