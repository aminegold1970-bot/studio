<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AssetStudioMobile.MainPage" Shell.NavBarIsVisible="False" BackgroundColor="#FFFFFF">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0" ColumnDefinitions="*">
        <Grid Grid.Row="0" HeightRequest="44" BackgroundColor="#F0F0F0">
            <ScrollView x:Name="MenuScroll" HeightRequest="44" Orientation="Horizontal" BackgroundColor="#F0F0F0"
                        SizeChanged="OnMenuScrollSizeChanged" Scrolled="OnMenuScrollScrolled">
                <HorizontalStackLayout Padding="4,0" Spacing="0" SizeChanged="OnMenuScrollSizeChanged">
                    <Button Text="File" Clicked="OnFileMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Options" Clicked="OnOptionsMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Model" Clicked="OnModelMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Export" Clicked="OnExportMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button x:Name="FilterTypeMenuButton" Text="Filter Type" Clicked="OnFilterMenuClicked" Style="{StaticResource MenuButton}"/>
                    <Button Text="Debug" Clicked="OnDebugMenuClicked" Style="{StaticResource MenuButton}"/>
                </HorizontalStackLayout>
            </ScrollView>
            <Button x:Name="MenuOverflowButton" Text="▸" Clicked="OnMenuOverflowClicked"
                    IsVisible="False" HorizontalOptions="End" VerticalOptions="Center"
                    Padding="0" WidthRequest="24" HeightRequest="44" MinimumWidthRequest="24"
                    MinimumHeightRequest="0" FontSize="13" TextColor="#444444"
                    BackgroundColor="#F0F0F0" BorderWidth="0"
                    AutomationProperties.Name="More menu items"
                    SemanticProperties.Hint="Scroll the menu bar to reveal more commands"/>
        </Grid>

        <Grid x:Name="WorkspaceViewTabs" Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="2,0" ColumnSpacing="1"
              BackgroundColor="#F0F0F0" IsVisible="False">
            <Button x:Name="SceneWorkspaceTab" Grid.Column="0" Text="Hierarchy" CommandParameter="Scene Hierarchy"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="AssetsWorkspaceTab" Grid.Column="1" Text="Assets" CommandParameter="Asset List"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="ClassesWorkspaceTab" Grid.Column="2" Text="Classes" CommandParameter="Asset Classes"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="PreviewWorkspaceTab" Grid.Column="3" Text="Preview" CommandParameter="Preview"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="DumpWorkspaceTab" Grid.Column="4" Text="Dump" CommandParameter="Dump"
                    Clicked="OnWorkspaceTabClicked" Style="{StaticResource TabButton}"/>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="*,28,0*" RowDefinitions="*" ColumnSpacing="0" BackgroundColor="#B7B7B7" SizeChanged="OnWorkspaceSizeChanged">
            <Grid x:Name="BrowserPane" Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="0" BackgroundColor="#FFFFFF">                        <Grid x:Name="BrowserTabsGrid" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Padding="2,0" ColumnSpacing="1" BackgroundColor="#F0F0F0">
            <Button x:Name="HierarchyTab" Grid.Column="0" Text="Scene Hierarchy" CommandParameter="Scene Hierarchy" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="AssetListTab" Grid.Column="1" Text="Asset List" CommandParameter="Asset List" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
            <Button x:Name="ClassesTab" Grid.Column="2" Text="Asset Classes" CommandParameter="Asset Classes" Clicked="OnBrowserTabClicked" Style="{StaticResource TabButton}"/>
        </Grid>

        <Grid x:Name="BrowserToolbarGrid" Grid.Row="1" RowDefinitions="21,Auto,Auto,Auto" Padding="2,0" BackgroundColor="#F0F0F0">
            <Border x:Name="AssetSearchFrame" Stroke="#B7B7B7" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="#FFFFFF" HeightRequest="21">
                <Entry x:Name="AssetSearch" Placeholder="Search" PlaceholderColor="#777777" TextColor="#202020" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" TextChanged="OnAssetSearchTextChanged"/>
            </Border>
            <Border x:Name="ClassSearchFrame" Grid.Row="0" IsVisible="False" Stroke="#B7B7B7" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="#FFFFFF" HeightRequest="21">
                <Entry x:Name="ClassSearch" Placeholder="Search" PlaceholderColor="#777777" TextColor="#202020" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" TextChanged="OnClassSearchTextChanged"/>
            </Border>
            <Grid x:Name="HierarchySearchPanel" Grid.Row="0" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                <Border x:Name="HierarchySearchFrame" Stroke="#B7B7B7" StrokeThickness="1" StrokeShape="Rectangle" Padding="5,0" BackgroundColor="#FFFFFF" HeightRequest="21">
                    <Entry x:Name="HierarchySearch" Placeholder="Search" PlaceholderColor="#777777" TextColor="#202020" BackgroundColor="Transparent" MinimumHeightRequest="0" FontSize="10" Margin="0" ReturnType="Search" Completed="OnHierarchySearchButtonPressed" TextChanged="OnHierarchySearchTextChanged"/>
                </Border>
                <Button x:Name="HierarchySearchNextButton" Grid.Column="1" Text="Next" IsVisible="False" Clicked="OnHierarchySearchNextClicked" Style="{StaticResource TabButton}"/>
            </Grid>
            <HorizontalStackLayout x:Name="HierarchyActions" Grid.Row="1" IsVisible="False" Spacing="5" Padding="0,3">
                <Button Text="Expand all" Clicked="OnHierarchyExpandAllClicked" Style="{StaticResource TabButton}"/>
                <Button Text="Collapse all" Clicked="OnHierarchyCollapseAllClicked" Style="{StaticResource TabButton}"/>
            </HorizontalStackLayout>
            <Grid x:Name="AssetColumnHeaders" Grid.Row="3" ColumnDefinitions="2*,1.25*,1.1*,1.1*,.7*,34" Padding="3,3" ColumnSpacing="2">
                <Button Text="Name" Clicked="OnSortName" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="1" Text="Container" Clicked="OnSortContainer" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="2" Text="Type" Clicked="OnSortType" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="3" Text="PathID" Clicked="OnSortPathId" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="4" Text="Size" Clicked="OnSortSize" Style="{StaticResource HeaderButton}"/>
            </Grid>
            <Grid x:Name="ClassColumnHeaders" Grid.Row="3" IsVisible="False" ColumnDefinitions="*,Auto,Auto" Padding="3,3" ColumnSpacing="2">
                <Button Text="Class name" Clicked="OnClassSortNameClicked" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="1" Text="ID" Clicked="OnClassSortIdClicked" Style="{StaticResource HeaderButton}"/>
                <Button Grid.Column="2" Text="Version" Clicked="OnClassSortVersionClicked" Style="{StaticResource HeaderButton}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" BackgroundColor="#FFFFFF">
                <CollectionView x:Name="AssetCollection" SelectionMode="Multiple" SelectionChanged="OnAssetSelectionChanged" BackgroundColor="#FFFFFF">
                    <CollectionView.EmptyView>
                        <Label x:Name="AssetEmptyLabel" Text="No assets loaded. Use File → Load file to load Unity assets." TextColor="#555555" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*" Padding="3,1" RowDefinitions="Auto,1" MinimumHeightRequest="26">
                                <Grid Grid.RowSpan="2" ColumnDefinitions="2*,1.25*,1.1*,1.1*,.7*,34"
                                      ColumnSpacing="5" IsVisible="{Binding IsDesktopLayout}">
                                    <Label Text="{Binding Name}" TextColor="#202020" FontSize="12" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding Container}" TextColor="#555555" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="2" Text="{Binding Type}" TextColor="#555555" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="3" Text="{Binding PathId}" TextColor="#555555" FontSize="11"/>
                                    <Label Grid.Column="4" Text="{Binding DisplaySize}" TextColor="#555555" FontSize="11"/>
                                    <Button Grid.Column="5" Text="⋯" Clicked="OnAssetContextClicked" CommandParameter="{Binding .}" Padding="0" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="0" MinimumHeightRequest="0" BackgroundColor="Transparent" TextColor="#555555" FontSize="16"/>
                                </Grid>
                                <Grid Grid.Row="0" ColumnDefinitions="*,34" RowDefinitions="Auto,Auto" RowSpacing="2"
                                      IsVisible="{Binding IsCompactLayout}">
                                    <Label Text="{Binding Name}" TextColor="#202020" FontSize="11" LineBreakMode="TailTruncation"/>
                                    <Button Grid.Column="1" Grid.RowSpan="2" Text="⋯" Clicked="OnAssetContextClicked" CommandParameter="{Binding .}" Padding="0" WidthRequest="24" HeightRequest="24" MinimumWidthRequest="0" MinimumHeightRequest="0" BackgroundColor="Transparent" TextColor="#555555" FontSize="16"/>
                                    <Label Grid.Row="1" Text="{Binding CompactDetails}" TextColor="#555555" FontSize="9" LineBreakMode="TailTruncation"/>
                                </Grid>
                                <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#D6D6D6"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView x:Name="HierarchyCollection" IsVisible="False" SelectionMode="Single" SelectionChanged="OnHierarchySelectionChanged" BackgroundColor="#FFFFFF">
                    <CollectionView.EmptyView><Label Text="No scene hierarchy loaded" TextColor="#555555" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="20,Auto,*" Padding="{Binding IndentPadding}" ColumnSpacing="4" MinimumHeightRequest="24">
                                <Button Text="{Binding ExpandGlyph}" Clicked="OnHierarchyExpandClicked" IsVisible="{Binding HasChildren}" Padding="0" WidthRequest="20" HeightRequest="20" MinimumWidthRequest="0" MinimumHeightRequest="0" BackgroundColor="Transparent" TextColor="#555555" FontSize="11"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" CheckedChanged="OnHierarchyCheckChanged" WidthRequest="16" HeightRequest="16" MinimumWidthRequest="0" MinimumHeightRequest="0" Color="#2878C8"/>
                                <Label Grid.Column="2" Text="{Binding DisplayName}" TextColor="#202020" VerticalTextAlignment="Center" FontSize="11" LineBreakMode="TailTruncation"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView x:Name="ClassesCollection" IsVisible="False" SelectionMode="Single" SelectionChanged="OnClassSelectionChanged" BackgroundColor="#FFFFFF">
                    <CollectionView.EmptyView><Label x:Name="ClassEmptyLabel" Text="No asset classes were loaded." TextColor="#555555" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="5,4" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" TextColor="#202020" FontSize="11"/>
                                    <Label Text="{Binding Version}" TextColor="#777777" FontSize="9"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Id}" TextColor="#555555" FontSize="10" VerticalTextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            </Grid><Grid x:Name="WorkspaceDivider" Grid.Row="0" Grid.Column="1" WidthRequest="28" BackgroundColor="#F0F0F0"
                         AutomationProperties.Name="Resize asset and preview panes"
                         SemanticProperties.Hint="Drag to resize panes. Tap to show or hide the preview pane.">
                <Button x:Name="WorkspacePaneToggleButton" Text="&gt;" Clicked="OnWorkspaceDividerToggleClicked"
                        Padding="0" WidthRequest="28" HeightRequest="44" MinimumWidthRequest="28"
                        MinimumHeightRequest="44" FontSize="14" TextColor="#444444"
                        BackgroundColor="Transparent" BorderWidth="0"/>
            </Grid>            <Grid x:Name="PreviewPane" Grid.Row="0" Grid.Column="2" RowDefinitions="*" RowSpacing="0" BackgroundColor="#A7A5A6"><Grid x:Name="PreviewTabsGrid" RowDefinitions="Auto,*" BackgroundColor="#F0F0F0" Grid.Row="0">
                <Grid ColumnDefinitions="Auto,Auto,*" Padding="2,1" ColumnSpacing="1" BackgroundColor="#F0F0F0">
                    <Button x:Name="PreviewTab" Text="Preview" Clicked="OnPreviewTabClicked" Style="{StaticResource TabButton}"/>
                    <Button x:Name="DumpTab" Grid.Column="1" Text="Dump" Clicked="OnDumpTabClicked" Style="{StaticResource TabButton}"/>
                </Grid>
                <Grid x:Name="EmptyPreviewSurface" Grid.Row="1" BackgroundColor="#A7A5A6" IsVisible="True">
                    <Label x:Name="PreviewEmptyLabel" Text="Select an asset&#10;to preview" TextColor="#666466" FontSize="26"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
                <ScrollView x:Name="PreviewScroll" Grid.Row="1" Padding="8" IsVisible="False">
                    <VerticalStackLayout Spacing="9">
                        <Label x:Name="PreviewTitle" Text="Preview" TextColor="#202020" FontSize="16" FontAttributes="Bold"/>
                        <Label x:Name="PreviewKind" Text="Select an asset" TextColor="#666666" FontSize="11"/>
                        <Border x:Name="ImagePreviewFrame" IsVisible="False" BackgroundColor="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1" Padding="6">
                            <VerticalStackLayout Spacing="6">
                                <Image x:Name="AssetImagePreview" Aspect="AspectFit" HeightRequest="230"/>
                                <Button x:Name="OpenFullTexturePreviewButton" Text="Open full-screen" Clicked="OnFullTexturePreviewClicked"
                                        IsVisible="False" Style="{StaticResource TabButton}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="TextPreviewFrame" IsVisible="False" BackgroundColor="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1" Padding="8">
                            <ScrollView Orientation="Both" HeightRequest="210">
                                <Label x:Name="AssetTextPreview" TextColor="#202020" FontFamily="monospace" FontSize="11" LineBreakMode="NoWrap"/>
                            </ScrollView>
                        </Border>
                        <Border x:Name="VideoPreviewFrame" IsVisible="False" BackgroundColor="#111111" Stroke="#C8C8C8" StrokeThickness="1" Padding="6">
                            <VerticalStackLayout Spacing="8">
                                <ContentView x:Name="VideoPlayerHost" HeightRequest="240" IsVisible="False"/>
                                <Button x:Name="LoadVideoPlaybackButton" Text="Load video for playback"
                                        Clicked="OnVideoPlayerClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                                <Label x:Name="VideoPlaybackStatus" Text="Select Load video to start playback."
                                       TextColor="#EEEEEE" FontSize="11"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="FontPreviewFrame" IsVisible="False" BackgroundColor="#F4F4F4" Stroke="#C8C8C8" StrokeThickness="1" Padding="10">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Font specimen" TextColor="#333333" FontSize="11"/>
                                <Label x:Name="FontSpecimenSmall" Text="The quick brown fox jumps over the lazy dog." TextColor="#111111" FontSize="12"/>
                                <Label x:Name="FontSpecimenMedium" Text="The quick brown fox jumps over the lazy dog." TextColor="#111111" FontSize="18"/>
                                <Label x:Name="FontSpecimenLarge" Text="The quick brown fox jumps over the lazy dog." TextColor="#111111" FontSize="26"/>
                                <Label x:Name="FontSpecimenCharacters" Text="0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ" TextColor="#111111" FontSize="15"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="AudioPreviewFrame" IsVisible="False" BackgroundColor="#F7F7F7" Stroke="#C8C8C8" StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Audio clip" TextColor="#202020" FontAttributes="Bold"/>
                                <Label x:Name="AudioPreviewInfo" TextColor="#444444" FontSize="12"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label x:Name="AudioPlaybackStatus" Text="Stopped" TextColor="#202020" FontSize="11" VerticalTextAlignment="Center"/>
                                    <Label x:Name="AudioFrequency" Grid.Column="1" Text="— Hz" TextColor="#444444" FontSize="11" VerticalTextAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="AudioSeekSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="OnAudioSeekChanged"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="AudioCurrentTime" Text="0:00" TextColor="#444444" FontSize="10"/>
                                    <Label x:Name="AudioDuration" Grid.Column="1" Text="0:00" TextColor="#444444" FontSize="10"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Button Text="▶ Play" Clicked="OnAudioPlayClicked" Style="{StaticResource TabButton}"/>
                                    <Button Grid.Column="1" Text="Ⅱ Pause" Clicked="OnAudioPauseClicked" Style="{StaticResource TabButton}"/>
                                    <Button Grid.Column="2" Text="■ Stop" Clicked="OnAudioStopClicked" Style="{StaticResource TabButton}"/>
                                    <Button x:Name="AudioLoopButton" Grid.Column="3" Text="Loop: Off" Clicked="OnAudioLoopClicked" Style="{StaticResource TabButton}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="Volume" TextColor="#444444" FontSize="11" VerticalTextAlignment="Center"/>
                                    <Slider x:Name="AudioVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" ValueChanged="OnAudioVolumeChanged"/>
                                </Grid>
                                <Label Text="Playback uses the platform's native audio player; export remains available for other formats." TextColor="#666666" FontSize="10"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="ModelPreviewFrame" IsVisible="False" BackgroundColor="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="3D model preview" TextColor="#202020" FontAttributes="Bold"/>
                                <Label x:Name="ModelPreviewInfo" Text="Select a Mesh asset to open its wireframe viewer." TextColor="#444444" FontSize="12"/>
                                <Button x:Name="OpenMeshPreviewButton" Text="Open wireframe preview" Clicked="OnMeshPreviewClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                                <Button x:Name="OpenSceneObjectPreviewButton" Text="Preview selected scene object" Clicked="OnSceneObjectPreviewClicked" IsVisible="False" Style="{StaticResource TabButton}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="MetadataFrame" IsVisible="False" BackgroundColor="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1" Padding="0">
                            <VerticalStackLayout x:Name="MetadataHost" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,1.2*" Padding="4,4" ColumnSpacing="8">
                                            <Label Text="{Binding Key}" TextColor="#555555" FontSize="11"/>
                                            <Label Grid.Column="1" Text="{Binding Value}" TextColor="#202020" FontSize="11" HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label x:Name="PreviewDetails" Text="Select an asset to inspect it." TextColor="#444444" FontSize="12"/>
                    </VerticalStackLayout>
                </ScrollView>
                <ScrollView x:Name="DumpScroll" Grid.Row="1" Padding="8" IsVisible="False">
                    <Label x:Name="DumpText" Text="Select an asset to view its dump." TextColor="#202020" FontFamily="monospace" FontSize="11"/>
                </ScrollView>
            </Grid>
        </Grid></Grid>        <Grid Grid.Row="3" RowDefinitions="Auto,3" ColumnDefinitions="*,Auto,Auto" Padding="5,2,5,0" ColumnSpacing="6" BackgroundColor="#F0F0F0">
            <Label x:Name="StatusLabel" Grid.Row="0" Text="Ready to go" TextColor="#444444" FontSize="12" VerticalTextAlignment="Center"/>
            <Button x:Name="CancelLoadButton" Grid.Row="0" Grid.Column="1" Text="Cancel load" IsVisible="False" Clicked="OnCancelLoadClicked" Padding="8,3" HeightRequest="26" MinimumHeightRequest="0" MinimumWidthRequest="0" FontSize="10" BackgroundColor="#7B3438" TextColor="White"/>
            <ActivityIndicator x:Name="BusyIndicator" Grid.Row="0" Grid.Column="2" IsRunning="False" IsVisible="False" HeightRequest="20"/>
            <ProgressBar x:Name="LoadProgressBar" Grid.Row="1" Grid.ColumnSpan="3" Progress="0" IsVisible="False" ProgressColor="#2D7D32" BackgroundColor="#D0D0D0" HeightRequest="3"/>
        </Grid>
        <Grid x:Name="MenuOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200">
            <BoxView BackgroundColor="#01000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuOverlayBackgroundTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="MenuPopupFrame" HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="4,44,4,0" WidthRequest="480" BackgroundColor="#FFFFFF"
                    Stroke="#888888" StrokeThickness="1" Padding="0" ZIndex="201">
                <ScrollView x:Name="MenuOptionsScroll" VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="MenuOptionsHost" Spacing="0"/>
                </ScrollView>
            </Border>
        </Grid>
        <Grid x:Name="DropTargetOverlay" Grid.RowSpan="4" IsVisible="False" InputTransparent="True"
              BackgroundColor="#662878C8" ZIndex="100">
            <Border Stroke="#2878C8" StrokeThickness="3" BackgroundColor="#F5FFFFFF"
                    Padding="28,20" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Drop files to load" TextColor="#202020" FontSize="18"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Unity assets, bundles, and ZIP files" TextColor="#555555" FontSize="12"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="13"/><Setter Property="TextColor" Value="#202020"/>
                <Setter Property="BackgroundColor" Value="#F0F0F0"/><Setter Property="BorderColor" Value="Transparent"/>
                <Setter Property="BorderWidth" Value="0"/><Setter Property="HeightRequest" Value="44"/>
                <Setter Property="MinimumHeightRequest" Value="44"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="PopupMenuItem" TargetType="Border">
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                <Setter Property="Stroke" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="HeightRequest" Value="24"/>
                <Setter Property="MinimumHeightRequest" Value="24"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="Padding" Value="2,1"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="10"/><Setter Property="TextColor" Value="#444444"/>
                <Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="BorderColor" Value="#B7B7B7"/>
                <Setter Property="BorderWidth" Value="1"/><Setter Property="HeightRequest" Value="22"/>
                <Setter Property="MinimumHeightRequest" Value="0"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="Padding" Value="5,0"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="10"/><Setter Property="TextColor" Value="#202020"/>
                <Setter Property="BackgroundColor" Value="#E2E2E2"/><Setter Property="BorderColor" Value="#B7B7B7"/>
                <Setter Property="BorderWidth" Value="1"/><Setter Property="HeightRequest" Value="22"/>
                <Setter Property="MinimumHeightRequest" Value="0"/><Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>
