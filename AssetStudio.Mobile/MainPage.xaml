<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AssetStudioMobile.MainPage"
             Title="AssetStudio">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Label Grid.Row="0"
               Text="AssetStudio"
               FontSize="28"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Text="Import Unity asset files or an AssetBundle to get started."
               LineBreakMode="WordWrap"
               TextColor="Gray" />

        <Grid Grid.Row="2" ColumnDefinitions="1.2*,*,*,*" ColumnSpacing="6">
            <Button x:Name="ImportButton"
                    Text="Import"
                    Clicked="OnImportClicked"
                    HorizontalOptions="Fill"
                    Grid.Column="0" />
            <Button x:Name="ExportButton"
                    Text="Export"
                    Clicked="OnExportClicked"
                    IsEnabled="False"
                    HorizontalOptions="Fill"
                    Grid.Column="1" />
            <Button x:Name="ExtractButton"
                    Text="Unpack"
                    Clicked="OnExtractClicked"
                    IsEnabled="False"
                    HorizontalOptions="Fill"
                    Grid.Column="2" />
            <Button x:Name="PreviewButton"
                    Text="View"
                    Clicked="OnPreviewClicked"
                    IsEnabled="False"
                    HorizontalOptions="Fill"
                    Grid.Column="3" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Filter assets"
                       TextChanged="OnSearchTextChanged" />
            <CollectionView x:Name="AssetList"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnAssetSelected">
                <CollectionView.EmptyView>
                    <Label Text="No assets to display."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1"
                                   Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label x:Name="SelectionLabel"
               Grid.Row="4"
               Text="Select an asset to share its raw data."
               FontSize="12"
               TextColor="Gray" />
    </Grid>
</ContentPage>
