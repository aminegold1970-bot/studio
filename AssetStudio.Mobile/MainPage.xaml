<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AssetStudioMobile.MainPage"
             Title="AssetStudio">
    <Grid Padding="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <Label Grid.Row="0"
               Text="AssetStudio"
               FontSize="26"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Text="Copy Unity files to Files > On My iPhone > AssetStudio, then select one below."
               LineBreakMode="WordWrap"
               TextColor="Gray" />

        <ScrollView Grid.Row="2" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="6">
                <Button Text="File" Clicked="OnFileMenuClicked" />
                <Button Text="Options" Clicked="OnOptionsMenuClicked" />
                <Button Text="Model" Clicked="OnModelMenuClicked" />
                <Button Text="Export" Clicked="OnExportMenuClicked" />
                <Button Text="Filter Type" Clicked="OnFilterMenuClicked" />
                <Button Text="Debug" Clicked="OnDebugMenuClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="1.2*,*,*,*" ColumnSpacing="6">
            <Button x:Name="ImportButton"
                    Text="Refresh"
                    Clicked="OnRefreshDocumentsClicked"
                    Grid.Column="0" />
            <Button x:Name="ExportButton"
                    Text="Export"
                    Clicked="OnExportClicked"
                    IsEnabled="False"
                    Grid.Column="1" />
            <Button x:Name="ExtractButton"
                    Text="Unpack"
                    Clicked="OnExtractClicked"
                    IsEnabled="False"
                    Grid.Column="2" />
            <Button x:Name="PreviewButton"
                    Text="View"
                    Clicked="OnPreviewClicked"
                    IsEnabled="False"
                    Grid.Column="3" />
        </Grid>

        <ScrollView Grid.Row="4" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="6">
                <Button Text="Files" CommandParameter="Files" Clicked="OnSectionClicked" />
                <Button Text="Scene" CommandParameter="Scene" Clicked="OnSectionClicked" />
                <Button Text="Assets" CommandParameter="Assets" Clicked="OnSectionClicked" />
                <Button Text="Classes" CommandParameter="Classes" Clicked="OnSectionClicked" />
                <Button Text="Preview" CommandParameter="Preview" Clicked="OnSectionClicked" />
                <Button Text="Dump" CommandParameter="Dump" Clicked="OnSectionClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Search assets"
                       TextChanged="OnSearchTextChanged" />
            <Picker x:Name="TypeFilter"
                    Grid.Column="1"
                    Title="All types"
                    WidthRequest="130"
                    SelectedIndexChanged="OnTypeFilterChanged" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid x:Name="DocumentsPanel" IsVisible="False" RowDefinitions="Auto,*">
                <Label x:Name="DocumentsHelp"
                       Padding="8"
                       Text="Files are read from this app's Documents folder. Copy Unity files to Files > On My iPhone > AssetStudio."
                       LineBreakMode="WordWrap"
                       TextColor="Gray" />
                <CollectionView x:Name="DocumentsList"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnDocumentSelected">
                    <CollectionView.EmptyView>
                        <Label Text="No files in AssetStudio Documents. Copy a Unity asset file or AssetBundle here, then tap Refresh."
                               Padding="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="Gray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1"
                                       Text="{Binding Metadata}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <CollectionView x:Name="AssetList"
                            SelectionMode="Single"
                            SelectionChanged="OnAssetSelected">
                <CollectionView.EmptyView>
                    <Label Text="No assets to display."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1"
                                   Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="Gray" />
                            <Label Grid.Row="2"
                                   Text="{Binding Metadata}"
                                   FontSize="11"
                                   TextColor="Gray"
                                   IsVisible="{Binding MetadataVisible}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="HierarchyList"
                            IsVisible="False"
                            SelectionMode="Single"
                            SelectionChanged="OnHierarchySelected">
                <CollectionView.EmptyView>
                    <Label Text="No GameObjects were found."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}"
                                   Margin="{Binding Indent}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1"
                                   Text="{Binding Type}"
                                   FontSize="11"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="ClassList"
                            IsVisible="False"
                            SelectionMode="Single"
                            SelectionChanged="OnClassSelected">
                <CollectionView.EmptyView>
                    <Label Text="No serialized class structures were found."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1"
                                   Text="{Binding Metadata}"
                                   FontSize="11"
                                   TextColor="Gray" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ScrollView x:Name="PreviewPanel" IsVisible="False">
                <VerticalStackLayout Padding="8" Spacing="12">
                    <Label Text="Asset preview"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label x:Name="PreviewSummary"
                           Text="Select an asset to inspect or preview it."
                           LineBreakMode="WordWrap" />
                    <Label x:Name="PreviewText"
                           IsVisible="False"
                           FontFamily="monospace"
                           LineBreakMode="WordWrap" />
                    <Button Text="Open full preview"
                            Clicked="OnPreviewClicked"
                            IsEnabled="False"
                            x:Name="PreviewPanelButton" />
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView x:Name="DumpPanel" IsVisible="False">
                <Label x:Name="DumpText"
                       Padding="8"
                       Text="Select an asset to view its serialized dump."
                       FontFamily="monospace"
                       LineBreakMode="WordWrap" />
            </ScrollView>
        </Grid>

        <Label x:Name="SelectionLabel"
               Grid.Row="7"
               Text="No asset selected."
               FontSize="12"
               TextColor="Gray" />
    </Grid>
</ContentPage>
